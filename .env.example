POSTGRES_USER=ofertas
POSTGRES_PASSWORD=cambiame
POSTGRES_DB=ofertas
POSTGRES_HOST_PORT=5436
DATABASE_URL=postgresql://ofertas:cambiame@postgres:5432/ofertas
LOG_LEVEL=INFO
SCRAPE_INTERVAL_HOURS=12

# Aviso post-pasada (opcional). Sin esto el resumen de corridas failed/partial
# queda solo en el log del scraper.
ALERT_BOT_TOKEN=
ALERT_CHAT_ID=

# --- Suscripciones (F2) ---------------------------------------------------
# Bot de onboarding: token de BotFather. Sin esto el servicio no arranca.
ONBOARDING_BOT_TOKEN=
# Username del bot SIN @, para armar los deep links de referidos.
ONBOARDING_BOT_USERNAME=
# Ids de Telegram autorizados a /stats, separados por coma. Vacío = comando cerrado.
ONBOARDING_ADMIN_IDS=
ONBOARDING_TRIAL_DAYS=7
ONBOARDING_DM_POLL_SECONDS=5
# Verificación de email antes del trial: on/off (anti-abuso de trials).
ONBOARDING_EMAIL_VERIFICATION=true
ONBOARDING_EMAIL_CODE_TTL_MINUTES=15
ONBOARDING_EMAIL_CODE_MAX_ATTEMPTS=5
ONBOARDING_PAYPAL_RETURN_URL=
ONBOARDING_PAYPAL_CANCEL_URL=

# Gate de canales: en false el reconciliador NO expulsa a nadie de Telegram.
# Arranca apagado a propósito: se prende recién cuando la seed de canales y los
# tiers están verificados, para que un error de configuración no eche gente.
GATE_ENABLED=false

# PayPal Subscriptions.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_WEBHOOK_PORT=8080
# Puerto en el host para el webhook (el que apunta el túnel/reverse proxy).
PAYPAL_WEBHOOK_HOST_PORT=8086
GATE_POLL_SECONDS=30
GATE_GRACE_DAYS=3
GATE_INVITE_TTL_HOURS=24
# Opcional: bot distinto para administrar los canales. Vacío = el de onboarding.
GATE_BOT_TOKEN=

# MercadoPago Suscripciones (preapproval), para el checkout en CLP. El access
# token es un secreto de larga vida: TEST-... en sandbox, APP_USR-... en
# producción (los crea el dueño en su panel de MercadoPago, no este repo).
# Sin esto el botón de MercadoPago no aparece en el bot — un plan sin
# mercadopago_plan_id/price_clp cargados a mano simplemente no se ofrece,
# igual que pasa hoy con un plan de PayPal sin paypal_plan_id.
MERCADOPAGO_ACCESS_TOKEN=
# Secreto de firma del webhook (panel MercadoPago → Tus integraciones →
# Webhooks). Sin esto el webhook de MercadoPago rechaza todo con 503: nunca
# arranca "verificando" sin secreto, como sí puede pasar con un access token
# vencido.
MERCADOPAGO_WEBHOOK_SECRET=
ONBOARDING_MERCADOPAGO_RETURN_URL=

# Email transaccional (Resend). Sin API key el código de verificación solo se
# loguea y el funnel se puede probar entero en dev.
RESEND_API_KEY=
FROM_EMAIL=

# Publisher de ofertas (F3). En false el daemon corre pero no postea nada.
# Arranca apagado a propósito: un mensaje publicado en un canal no se deshace.
PUBLISHER_ENABLED=false
# Cada cuánto le pregunta al ranker. Corto no significa publicar más: la cuota
# y el espaciado mínimo viven en curation/ranker.py, no acá.
PUBLISHER_POLL_SECONDS=300
# Opcional: bot distinto para postear. Vacío = GATE_BOT_TOKEN, y si tampoco, el
# de onboarding.
PUBLISHER_BOT_TOKEN=
# Guarda del canal mudo (publisher/guarda_canal.py): avisa si pasó el deadline y
# todavía no salió el PRIMER post del día. Apagada por default, como todo lo que
# habla hacia afuera. Necesita ALERT_BOT_TOKEN/ALERT_CHAT_ID cargados.
PUBLISHER_ALERTA_CANAL_MUDO=false
# Hora UTC del deadline. 13 es el default medido: en los 49 días de historia del
# canal dispara 3 veces y las 3 son incidentes reales. **No la bajes a 12 sin
# leer research/2026-11-09/GUARDA_canal_mudo.md**: con la ventana que el canal
# tenía hasta el 2026-10-21 (abría 09:00 de Santiago = 12:00 UTC) ese umbral
# habría disparado en falso 23 días seguidos. Es un número atado a
# ranker.WINDOW_START_HOUR y al offset de Santiago, no una verdad absoluta.
PUBLISHER_ALERTA_DEADLINE_HOUR_UTC=13
